<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately empty, but not *empty*.

  The artwork is a complete composition — a compass at the centre of a
  ring of eight tool glyphs — not a mark sitting on a background, so it
  is the background layer, full bleed, and the launcher applies its own
  mask. In the foreground it would be scaled into the 72dp safe zone and
  surrounded by dark border, which reads as a picture of an icon.

  The path below is one fully transparent pixel. A vector with no paths
  at all is not a drawable that `AdaptiveIconDrawable` will accept, and
  when it rejects one layer the launcher falls back to the platform
  placeholder robot — which is exactly what a completely empty
  foreground produced.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0 h1 v1 h-1 z"
        android:fillColor="#00000000" />
</vector>
